{
  "name": "Parts planning POC",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" }
  },
  "postCreateCommand": "pip install --user -r requirements.txt && npm install -g @anthropic-ai/claude-code",
  "postAttachCommand": "streamlit run app.py --server.enableCORS false --server.enableXsrfProtection false",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": { "label": "Dashboard", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python"] },
    "codespaces": { "openFiles": ["README.md", "app.py"] }
  }
}
